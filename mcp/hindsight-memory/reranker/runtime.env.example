# Append to the existing private hindsight.env after conversion and benchmark.
# The original shared.env embedding/provider/key settings remain in their owner.
HINDSIGHT_API_RERANKER_PROVIDER=onnx
HINDSIGHT_API_RERANKER_ONNX_MODEL_PATH=D:\Hindsight\models\bge-reranker-v2-m3-e099d4b9-q8\int8\model_q8_avx2.onnx
HINDSIGHT_API_RERANKER_ONNX_TOKENIZER_NAME_OR_PATH=D:\Hindsight\models\bge-reranker-v2-m3-e099d4b9-q8\int8
HINDSIGHT_API_RERANKER_ONNX_THREADS=4
HINDSIGHT_API_RERANKER_ONNX_BATCH_SIZE=8
HINDSIGHT_API_RERANKER_ONNX_MAX_CONCURRENT=1
HINDSIGHT_API_RERANKER_ONNX_CPU_MEM_ARENA=false
# CPU benchmark: ~57s for 287 pairs. Bound the normal rerank to 100 candidates.
HINDSIGHT_API_RERANKER_MAX_CANDIDATES=100
