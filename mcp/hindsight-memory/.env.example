# Copy applicable fields to the ignored repository .env. Private values stay local.
HINDSIGHT_NETWORK=lan
HINDSIGHT_WIN_LAN_HOST=<win-lan-ip>
HINDSIGHT_WIN_EASYTIER_HOST=<win-easytier-ip>
HINDSIGHT_WIN_SSH_USER=<ssh-user>
HINDSIGHT_WIN_SSH_PORT=22
HINDSIGHT_WIN_SSH_HOST_KEY_ALIAS=<existing-verified-host-key-alias>
HINDSIGHT_WIN_PYTHON='D:\Hindsight\app\.venv\Scripts\python.exe'
HINDSIGHT_WIN_MCP_BRIDGE='D:\Hindsight\scripts\mcp-bridge.py'
HINDSIGHT_WIN_API_RELAY='D:\Hindsight\scripts\api_relay.py'
HINDSIGHT_WIN_LOCAL_MCP_URL=http://127.0.0.1:8888/mcp/

# VPS policy only: Mac LAN has no new retry layer.
HINDSIGHT_CONNECT_TIMEOUT_SEC=15
HINDSIGHT_REQUEST_TIMEOUT_SEC=90
HINDSIGHT_TOTAL_TIMEOUT_SEC=180
HINDSIGHT_MAX_ATTEMPTS=2
